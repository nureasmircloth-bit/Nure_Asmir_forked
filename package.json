{
  "name": "nure-asmir-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "search:reindex": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/search-reindex.ts",
    "brand:assets": "node ./node_modules/tsx/dist/cli.mjs scripts/build-brand-assets.ts",
    "cf:build:store": "node scripts/build-target.mjs store build",
    "cf:build:admin": "node scripts/build-target.mjs admin build",
    "cf:preview:store": "node scripts/build-target.mjs store preview",
    "cf:preview:admin": "node scripts/build-target.mjs admin preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@sentry/nextjs": "^11.4.0",
    "algoliasearch": "^5.59.0",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.19.0",
    "lucide-react": "^1.27.0",
    "minisearch": "^7.2.0",
    "nanoid": "^6.0.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.83.0",
    "resend": "^6.18.1",
    "tailwind-merge": "^3.6.0",
    "wrangler": "^4.147.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "exceljs": "^4.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
