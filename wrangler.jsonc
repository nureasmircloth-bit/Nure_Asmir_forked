{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nure-asmir",
  // worker-entry.ts wraps .open-next/worker.js with the nearby page cache and the timer (see that file).
  "main": "worker-entry.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  // The database (Cloudflare D1, SQLite). The store and the admin share one database.
  "d1_databases": [
    { "binding": "DB", "database_name": "nure-asmir-prod", "database_id": "55b97328-231b-4fa7-ba88-8b825dfcb337", "migrations_dir": "drizzle" },
    // The same database again, under the name OpenNext looks for (its page-cache tags, see open-next.config.ts).
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "nure-asmir-prod", "database_id": "55b97328-231b-4fa7-ba88-8b825dfcb337" }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Backs OpenNext's incremental (ISR) cache — see open-next.config.ts. A small Cloudflare R2
  // bucket used only for cached page renders (product / category / campaign IMAGES live in Neon
  // Object Storage, not here). Create it once with: npx wrangler r2 bucket create nure-asmir-cache
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "nure-asmir-cache-apac" },
    // Second picture store (10 GB free), in Cloudflare's Asia-Pacific region (nearest to Pakistan), used next to Neon Storage – see lib/storage.ts. Created by the deploy workflow.
    { "binding": "MEDIA_R2", "bucket_name": "nure-asmir-media-apac" },
    // The first picture bucket (created in eastern North America): still read from, never written to.
    { "binding": "MEDIA_R2_LEGACY", "bucket_name": "nure-asmir-media-r2" }
  ],
  "vars": { "APP_TARGET": "store", "EDGE_PAGE_CACHE": "1" },
  // Cloudflare's own timer: every 3 minutes (keeps the database awake; runs the shop's scheduled jobs on time).
  "triggers": { "crons": ["*/3 * * * *"] },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  // The shop on the real domain (Cloudflare creates the DNS records and certificates).
  "routes": [
    { "pattern": "nureasmir.com", "custom_domain": true },
    { "pattern": "www.nureasmir.com", "custom_domain": true }
  ]
}
