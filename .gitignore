# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# opennext / cloudflare build output
/.open-next/
.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# local tooling / reference material (never committed)
.claude/
/ismail_farid/
# client assets: only the web-optimised set is tracked (used by scripts/seed.ts)
/nure_asmir_assets/*
!/nure_asmir_assets/web/

.dev.vars
!.env.example

# split-build scratch + e2e output
.build-excluded/
/test-results/
/playwright-report/
/e2e/.artifacts/
.env.development.local
.next-prod/

# service-account keys / credentials (never committed)
*-firebase-adminsdk-*.json
*serviceAccount*.json

# generated by scripts/copy-vendor.mjs
/public/vendor/

/wrangler.deploy.jsonc
/wrangler.admin.deploy.jsonc
/wrangler.training.deploy.jsonc
