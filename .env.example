# Copy to .env.local (local) — production values are Cloudflare Worker secrets, pushed by
# .github/workflows/deploy.yml from GitHub Actions secrets of the same names.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: a Cloudflare-proxied hostname (e.g. https://cdn.example.com) that fronts the Neon media
# bucket. Leave empty to serve images through the same-origin /cdn route.
NEXT_PUBLIC_CDN_URL=

# --- Neon (written by `neon env pull` / `neon deploy`) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Object Storage (S3-compatible)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
STORAGE_PUBLIC_BUCKET=nure-asmir-media
STORAGE_PRIVATE_BUCKET=nure-asmir-private

# --- Admin ---
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
SESSION_SECRET=
# Fixed CSP nonce shared by every response (see lib/nonce.ts for why it is not per-request)
CSP_NONCE=
CRON_SECRET=

# --- Firebase Cloud Messaging (push) ---
# Service-account JSON key as ONE line (Firebase console → Project settings → Service accounts)
FIREBASE_SERVICE_ACCOUNT=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Split deployment (storefront + admin Workers) ---
# Public URL of the admin Worker (footer "Admin" link) and of the storefront (admin "view store" link)
NEXT_PUBLIC_ADMIN_URL=
NEXT_PUBLIC_STORE_URL=

# --- Algolia search ---
ALGOLIA_APP_ID=
# Write key — server only
ALGOLIA_ADMIN_KEY=
ALGOLIA_INDEX_NAME=nure_asmir_products
NEXT_PUBLIC_ALGOLIA_APP_ID=
# Search-only key restricted to the index — safe for the browser
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=nure_asmir_products

# --- Sentry (public DSN) ---
NEXT_PUBLIC_SENTRY_DSN=
# Public PostHog (EU) project key for the storefront analytics; leave empty to keep analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
# Shared password of the training lab (training.nureasmir.com); only the training Worker reads it.
TRAINING_PASSWORD=
# CI only (source map upload)
SENTRY_AUTH_TOKEN=

# --- Messaging / couriers / analytics (optional until enabled) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Nure Asmir
WHATSAPP_DEFAULT_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
TCS_USERNAME=
TCS_PASSWORD=
TCS_ACCOUNT_NO=
TCS_COST_CENTER_CODE=
# "production" only after TCS has approved your UAT; anything else uses TCS's test servers.
TCS_ENV=
# TCS service code (default O = overnight).
TCS_SERVICE_CODE=
GROQ_API_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_MERCHANT_ID=

# --- Cloudflare R2 (ISR page cache only — scripts/purge-isr-cache.ts) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=nure-asmir-cache
