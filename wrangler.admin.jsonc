{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The owner's admin panel – a separate Worker from the storefront (see scripts/build-target.mjs):
  // shoppers never download or share a bundle with it, and it has its own origin, cookies and robots rules.
  "name": "nure-asmir-admin",
  // admin-entry.ts wraps .open-next/worker.js with a timer that keeps the database and the admin code warm (see that file).
  "main": "admin-entry.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  // The database (Cloudflare D1, SQLite). The store and the admin share one database.
  "d1_databases": [{ "binding": "DB", "database_name": "nure-asmir-prod", "database_id": "55b97328-231b-4fa7-ba88-8b825dfcb337", "migrations_dir": "drizzle" }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "nure-asmir-cache" },
    // Second picture store (10 GB free) used next to Neon Storage – see lib/storage.ts. Created by the deploy workflow.
    { "binding": "MEDIA_R2", "bucket_name": "nure-asmir-media-r2" }
  ],
  "vars": { "APP_TARGET": "admin" },
  "triggers": { "crons": ["*/3 * * * *"] },
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "admin.nureasmir.com", "custom_domain": true }]
}
