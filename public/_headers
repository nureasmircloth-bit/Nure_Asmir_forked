# Cloudflare's Workers Static Assets serves everything in public/ directly — Next.js's own headers()
# never runs for these files, so cache policy is declared here (same convention as Cloudflare Pages).

# Content-hashed build output: a new filename every deploy, so it can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned third-party files (the Excel library the admin uses): the name changes with the version, so keep forever.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must always be re-checked so a deploy reaches visitors promptly.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# Brand files keep their names across deploys: cache for a week and refresh quietly after that.
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/flags/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/logo*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/placeholder.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/llms.txt
  Cache-Control: public, max-age=3600
